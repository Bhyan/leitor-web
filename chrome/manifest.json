{
  "manifest_version": 3,
  "name": "Leitor Web — Anotações",
  "version": "1.0.0",
  "description": "Modo leitura, cores personalizadas, comentários com exclusão e painel de anotações.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Abrir modo leitura",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
